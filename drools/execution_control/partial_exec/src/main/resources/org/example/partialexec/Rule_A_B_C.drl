package org.example.partialexec;

rule "Rule_Aを記録"
    when
        $data : ExecutedRules()
    then
        $data.recordRuleName("Rule_A");
end

rule "Rule_Bを記録"
    when
        $data : ExecutedRules()
    then
        $data.recordRuleName("Rule_B");
end

rule "Rule_Cを記録"
    when
        $data : ExecutedRules()
    then
        $data.recordRuleName("Rule_C");
end
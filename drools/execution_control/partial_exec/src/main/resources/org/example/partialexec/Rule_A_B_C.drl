package org.example.partialexec;

rule "Rule_A"
    when
        $data : ExecutedRules()
    then
        $data.recordRuleName("Rule_A");
end

rule "Rule_B"
    when
        $data : ExecutedRules()
    then
        $data.recordRuleName("Rule_B");
end

rule "Rule_C"
    when
        $data : ExecutedRules()
    then
        $data.recordRuleName("Rule_C");
end
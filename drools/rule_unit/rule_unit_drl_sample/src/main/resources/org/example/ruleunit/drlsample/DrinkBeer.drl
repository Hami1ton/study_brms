package org.example.ruleunit.drlsample;
unit DrinkBeerRuleUnit;

rule "20歳未満なのでオレンジジュースにする"
    when
        /persons[ age < 20 ]
    then
        drinkList.add(new Drink("Orange Juice"));
end

rule "20歳以上なのでビールが飲める"
    when
        /persons[ age >= 20 ]
    then
        drinkList.add(new Drink("Beer"));
end
